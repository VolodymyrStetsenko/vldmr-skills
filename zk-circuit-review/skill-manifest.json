    "files": {
      "read": [
        "$SKILL_DIR/SKILL.md",
        "$SKILL_DIR/references/**",
        "$SKILL_DIR/scripts/**",
        "target-circuit-scope/**"
      ],
      "write": [
        "project-root/zk-review/**"
      ],
      "deny_read": [
        "**/.env",
        "**/credentials*",
        "~/.aws/**",
        "~/.ssh/**",
        "**/*.wallet"
      ],
      "deny_write": [
        "AGENTS.md",
        "MEMORY.md",
        "SOUL.md"
      ]
    },
    "network": {
      "allow": [],
      "deny": "*"
    },
    "shell": {
      "enabled": true,
      "commands": [
        "cat",
        "mkdir",
        "python3"
      ]
    },
    "tools": [
      "read_file",
      "run_in_terminal"
    ]
  },
  "requires": {
    "binaries": [
      "python3"
    ],
    "python": ">=3.9",
    "dependencies": []
  },
  "risk_tier": "L1",
  "security": {
    "target_code_execution": false,
    "external_instructions": [],
    "identity_file_access": "denied",
    "dynamic_analysis": "optional-user-approved",
    "data_handling": "source-derived paths and identifiers may appear in local reports"
  },
