{
  "schema": "vldmr.skill-security.v1",
  "name": "zk-circuit-review",
  "version": "1.0.0",
  "description": "Offline static review workflow for Circom, Noir, and Halo2 circuit soundness and completeness.",
  "author": {
    "name": "Volodymyr Stetsenko",
